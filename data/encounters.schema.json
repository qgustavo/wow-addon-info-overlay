{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WowQuickRefEncounters",
  "type": "object",
  "required": ["patch", "season", "raid", "mythicplus"],
  "additionalProperties": false,
  "properties": {
    "patch": { "type": "string" },
    "season": { "type": "integer" },
    "raid": { "type": "array", "items": { "$ref": "#/$defs/encounter" } },
    "mythicplus": { "type": "array", "items": { "$ref": "#/$defs/encounter" } }
  },
  "$defs": {
    "encounter": {
      "type": "object",
      "required": ["name", "kind", "lines", "sources"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["raid", "dungeon"] },
        "instance": { "type": "string" },
        "lines": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
        "specNotes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
